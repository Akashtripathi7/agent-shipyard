<svg viewBox="0 0 620 410" role="img" aria-label="The agent loop: observe, think, act and check, repeated inside Claude Code until the agent stops with evidence or asks you.">
  <defs><marker id="al-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" class="d-arrow" /></marker>
  <marker id="al-g" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" class="d-arrow-acc" /></marker></defs>
  <rect x="16" y="16" width="588" height="300" rx="16" class="d-frame" />
  <text x="34" y="42" class="d-tm">CLAUDE CODE · THE HARNESS</text>
  <rect x="52" y="66" width="200" height="66" rx="12" class="d-box" />
  <text x="152" y="95" text-anchor="middle" class="d-t">Observe</text>
  <text x="152" y="116" text-anchor="middle" class="d-ts">read files, git status</text>
  <rect x="368" y="66" width="200" height="66" rx="12" class="d-acc" />
  <text x="468" y="95" text-anchor="middle" class="d-t">Think</text>
  <text x="468" y="116" text-anchor="middle" class="d-ta">the model decides</text>
  <rect x="368" y="222" width="200" height="66" rx="12" class="d-box" />
  <text x="468" y="251" text-anchor="middle" class="d-t">Act</text>
  <text x="468" y="272" text-anchor="middle" class="d-ts">edit a file, run a command</text>
  <rect x="52" y="222" width="200" height="66" rx="12" class="d-box" />
  <text x="152" y="251" text-anchor="middle" class="d-t">Check</text>
  <text x="152" y="272" text-anchor="middle" class="d-ts">read the test output</text>
  <rect x="52" y="344" width="200" height="50" rx="12" class="d-brass" />
  <text x="152" y="374" text-anchor="middle" class="d-t">Stop: report, or ask you</text>
  <line x1="254" y1="99" x2="364" y2="99" class="d-line" marker-end="url(#al-a)" />
  <text x="309" y="89" text-anchor="middle" class="d-ts">what it saw</text>
  <line x1="468" y1="134" x2="468" y2="218" class="d-line" marker-end="url(#al-a)" />
  <text x="478" y="180" class="d-ts">a tool call</text>
  <line x1="366" y1="255" x2="256" y2="255" class="d-line" marker-end="url(#al-a)" />
  <text x="311" y="245" text-anchor="middle" class="d-ts">the result</text>
  <line x1="152" y1="220" x2="152" y2="136" class="d-line" marker-end="url(#al-a)" />
  <text x="142" y="182" text-anchor="end" class="d-ts">not done yet</text>
  <line x1="152" y1="290" x2="152" y2="340" class="d-line-acc" marker-end="url(#al-g)" />
  <text x="162" y="320" class="d-ta">done, with evidence</text>
</svg>
