<svg viewBox="0 0 640 330" role="img" aria-label="The lethal trifecta: private data, untrusted content and a way out. Where all three overlap, an agent can be tricked into leaking. Remove any one and the attack fails.">
  <circle cx="240" cy="130" r="100" class="d-sky" style="fill-opacity:.55" />
  <circle cx="400" cy="130" r="100" class="d-brass" style="fill-opacity:.55" />
  <circle cx="320" cy="222" r="100" class="d-coral" style="fill-opacity:.55" />
  <text x="190" y="100" text-anchor="middle" class="d-t">Private data</text>
  <text x="190" y="118" text-anchor="middle" class="d-ts">tokens, .env, user data</text>
  <text x="452" y="100" text-anchor="middle" class="d-t">Untrusted content</text>
  <text x="452" y="118" text-anchor="middle" class="d-ts">web pages, issues, READMEs</text>
  <text x="320" y="290" text-anchor="middle" class="d-t">A way out</text>
  <text x="320" y="308" text-anchor="middle" class="d-ts">network, webhooks, pushes</text>
  <text x="320" y="170" text-anchor="middle" class="d-tc">leak possible</text>
  <text x="560" y="210" text-anchor="middle" class="d-ta">remove any one</text>
  <text x="560" y="228" text-anchor="middle" class="d-ta">and it fails</text>
</svg>
