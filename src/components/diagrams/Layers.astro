<svg viewBox="0 0 640 330" role="img" aria-label="A layered monolith. Requests enter the routes layer, which calls services, which call repositories, which talk to the database. Dependencies only point downward.">
  <defs><marker id="ly-a" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto"><path d="M0,0 L10,5 L0,10 z" class="d-arrow-acc" /></marker></defs>
  <rect x="120" y="20" width="400" height="58" rx="10" class="d-sky" />
  <text x="320" y="46" text-anchor="middle" class="d-t">Routes (HTTP)</text>
  <text x="320" y="64" text-anchor="middle" class="d-ts">parse the request, check input, return the response</text>
  <rect x="120" y="100" width="400" height="58" rx="10" class="d-acc" />
  <text x="320" y="126" text-anchor="middle" class="d-t">Services (business rules)</text>
  <text x="320" y="144" text-anchor="middle" class="d-ts">"an expense can't be in the future", totals, permissions</text>
  <rect x="120" y="180" width="400" height="58" rx="10" class="d-brass" />
  <text x="320" y="206" text-anchor="middle" class="d-t">Repositories (data access)</text>
  <text x="320" y="224" text-anchor="middle" class="d-ts">the only place that writes SQL</text>
  <rect x="220" y="260" width="200" height="50" rx="10" class="d-box-2" />
  <text x="320" y="290" text-anchor="middle" class="d-t">PostgreSQL</text>
  <line x1="560" y1="30" x2="560" y2="300" class="d-line-acc" marker-end="url(#ly-a)" />
  <text x="572" y="160" class="d-ta">depends on</text>
  <text x="572" y="176" class="d-ta">(downward only)</text>
  <text x="20" y="52" class="d-tm">KNOWS HTTP</text>
  <text x="20" y="132" class="d-tm">KNOWS NEITHER</text>
  <text x="20" y="212" class="d-tm">KNOWS SQL</text>
</svg>
