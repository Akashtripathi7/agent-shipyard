---
// A real failure story. Put two <BreakPart> blocks inside: what happens, and the fix.
interface Props { title: string }
const { title } = Astro.props;
---
<section class="block breaks">
  <div class="block-label">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10.3 3.9 1.8 18a2 2 0 0 0 1.7 3h17a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0zM12 9v4M12 17h.01"/></svg>
    How it breaks in real life
  </div>
  <h3 class="br-title">{title}</h3>
  <div class="breaks-grid"><slot /></div>
</section>
