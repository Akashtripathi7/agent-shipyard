---
// A hands-on exercise. Put the steps as a numbered Markdown list inside.
// `predict` shows a saved "write your prediction first" box above the steps.
interface Props { title: string; time?: string; id: string; predict?: string }
const { title, time, id, predict } = Astro.props;
---
<section class="block exercise" id={`ex-${id}`}>
  <div class="exercise-head">
    <div class="block-label">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
      Hands-on
    </div>
    {time && <span class="ex-time">{time}</span>}
    <h3 class="ex-title">{title}</h3>
  </div>
  {predict && (
    <div class="predict">
      <label for={`predict-${id}`}>Predict first</label>
      <p style="margin:0 0 8px;font-size:.95rem">{predict}</p>
      <textarea id={`predict-${id}`} data-note={`predict:${id}`} placeholder="Write your prediction before you run anything. It saves automatically."></textarea>
    </div>
  )}
  <div class="ex-body"><slot /></div>
</section>
