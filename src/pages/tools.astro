---
import Base from '../layouts/Base.astro';
import { tools, toolGroups } from '../data/tools';
import { hrefOf, navItems, writtenSlugs } from '../lib/nav';

const items = await navItems();
const written = await writtenSlugs();
const titleOf = (slug?: string) => (slug ? items.find((i) => i.slug === slug)?.title : undefined);
---

<Base
  title="Tool index"
  description="Every tool named in the course: what it does for you, when it earns a place in your setup, and the lesson that uses it."
  active="tools"
>
  <main id="main" class="ref">
    <header class="ref-head">
      <p class="eyebrow">Tool index</p>
      <h1>Every tool, and when it earns its place</h1>
      <p class="lede">
        Nothing here is required to start. Each tool solves a specific frustration, and installing it before you have
        felt that frustration just gives you configuration to maintain. The "adopt when" column is the important one.
      </p>
      <p class="note">
        Tools in this field change monthly. Where a command in a lesson has stopped working, check the tool's own
        documentation before working around it — and tell me, so the lesson can be fixed.
      </p>
    </header>

    {toolGroups.map((g) => (
      <section class="group">
        <h2>{g}</h2>
        <div class="tbl-wrap" tabindex="0" role="region" aria-label={g}>
          <table>
            <thead>
              <tr><th>Tool</th><th>What it does for you</th><th>Adopt when</th><th>In the course</th></tr>
            </thead>
            <tbody>
              {tools.filter((t) => t.group === g).map((t) => (
                <tr>
                  <td class="name">{t.href ? <a href={t.href} rel="noreferrer">{t.name}</a> : t.name}</td>
                  <td>{t.what}</td>
                  <td class="when">{t.when}</td>
                  <td class="where">{t.lesson && written.has(t.lesson)
                    ? <a href={hrefOf(t.lesson)}>{titleOf(t.lesson) ?? t.lesson}</a>
                    : t.lesson ? <span class="dash">later tier</span> : <span class="dash">—</span>}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    ))}
  </main>
</Base>

<style>
  .ref { max-width: 1100px; margin: 0 auto; padding: 56px 22px 100px; }
  .ref-head { max-width: 72ch; }
  .eyebrow { font: 700 0.76rem var(--font-mono); letter-spacing: 0.13em; text-transform: uppercase; color: var(--accent-strong); margin-bottom: 12px; }
  h1 { font-size: clamp(2.1rem, 5vw, 3.2rem); font-weight: 800; letter-spacing: -0.035em; margin-bottom: 16px; }
  .lede { font-size: 1.12rem; color: var(--ink-soft); margin-bottom: 16px; }
  .group { margin-top: 52px; }
  .group h2 { font-size: clamp(1.4rem, 3vw, 1.85rem); font-weight: 750; letter-spacing: -0.025em; margin-bottom: 16px; }
  .tbl-wrap:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .tbl-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius-l); background: var(--surface); }
  table { border-collapse: collapse; width: 100%; min-width: 760px; font-size: 0.94rem; }
  th { text-align: left; font: 700 0.68rem var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-faint); padding: 12px 16px; border-bottom: 1px solid var(--line); }
  td { padding: 14px 16px; border-bottom: 1px solid var(--line); vertical-align: top; color: var(--ink-soft); }
  tr:last-child td { border-bottom: 0; }
  .name { font-weight: 650; color: var(--ink); white-space: nowrap; }
  .when { color: var(--ink); }
  .where { white-space: nowrap; }
  .dash { color: var(--ink-faint); }
  @media (max-width: 560px) { .ref { padding-top: 36px; } }
</style>
