---
import Base from '../layouts/Base.astro';
import ProgressRing from '../components/ProgressRing.astro';
import { groupedNav, navItems } from '../lib/nav';
import { projects, sections, tiers, type Tier } from '../data/course';
import { kit } from '../data/kit';
import { glossary } from '../data/glossary';
import { allPlainTerms } from '../data/terms';
import { tools } from '../data/tools';
import { competencies } from '../data/competencies';

const items = await navItems();
const groups = await groupedNav();
const count = (k: string) => items.filter((i) => i.kind === k).length;
const lessons = items.filter((i) => ['lesson', 'arch', 'decision'].includes(i.kind)).length;
const stats = [
  { n: groups.filter((g) => g.section.kind === 'part' || g.section.kind === 'decisions').map((g) => g.section.label.replace(/,.*/, '')).filter((v, i, a) => a.indexOf(v) === i).length, l: 'parts' },
  { n: lessons, l: 'lessons' },
  { n: projects.length, l: 'guided projects' },
  { n: count('drill'), l: 'decision drills' },
  { n: 1, l: 'mastery exam' },
];
const firstHref = items[0]?.href ?? '/';
const written = new Set(items.map((i) => i.slug));

// Short, honest labels for what a section is, so the route reads as a shape
// rather than a list of names.
const kindLabel: Record<string, string> = {
  start: 'Setup',
  part: 'Workflow',
  arch: 'Architecture',
  project: 'Build',
  decisions: 'Judgment',
  exam: 'Exam',
};

const tierList = ([1, 2, 3, 4] as Tier[]).map((t) => {
  const secs = sections
    .filter((sec) => sec.tier === t)
    .map((sec) => {
      const group = groups.find((g) => g.section.id === sec.id);
      const pages = group?.items ?? [];
      return {
        id: sec.id,
        label: sec.label,
        title: sec.title,
        blurb: sec.blurb,
        kind: sec.kind,
        kindLabel: kindLabel[sec.kind] ?? sec.kind,
        href: pages[0]?.href,
        pages: pages.length,
        ready: pages.length > 0,
      };
    });
  const tierSlugs = items.filter((i) => i.tier === t).map((i) => i.slug);
  return {
    t,
    ...tiers[t],
    secs,
    lessons: tierSlugs.length,
    slugs: tierSlugs,
    planned: secs.filter((sc) => !sc.ready).length,
    builds: projects.filter((pr) => pr.tier === t),
  };
});

// How a lesson is built. Every one of these is a real component the lessons use,
// so this list cannot drift away from what a reader actually gets.
const anatomy = [
  { k: 'Plain English first', d: 'Every idea arrives in ordinary words, with an analogy before the jargon. Nothing assumes you already know the term.' },
  { k: 'New words, defined', d: 'Each lesson ends its concepts with a box defining the terms it just used — the same definitions the glossary holds.' },
  { k: 'Do it yourself', d: 'A numbered exercise on your own machine, with the exact prompt to send and what you should see when it works.' },
  { k: 'When it breaks', d: 'The failure you are most likely to hit, why it happens, and how to get out of it. Written before you hit it, not after.' },
  { k: 'Check you understood', d: 'A short quiz and a checklist. Both are marked in your browser, so the lesson only counts as done when you can answer it.' },
  { k: 'Decision drills', d: 'Scenarios with no code: you choose the workflow, then compare with a worked answer. This is where judgment is built.' },
];

const prereqs = [
  { t: 'You can write code', d: 'Any language. You do not need to be senior — you need to be able to read a diff and tell whether it is sane.' },
  { t: 'A terminal you are not afraid of', d: 'Part 0 teaches tmux and git worktrees from zero, but basic shell and git are assumed.' },
  { t: 'Claude Code, or an equivalent', d: 'The lessons are written against Claude Code. The ideas transfer; the exact commands do not.' },
  { t: 'Four to six hours a week', d: 'Tier 1 is a weekend. The whole path, projects included, is a few months at that pace.' },
];

const refs = [
  { href: '/kit/', label: 'Your kit', n: kit.length, unit: 'files', d: 'Every instruction file, skill, subagent, hook and gate the course has you build, ready to download into a new project.' },
  { href: '/skills/', label: 'Skills map', n: competencies.length, unit: 'competencies', d: 'The abilities behind the lessons, and your level in each one, rising as you mark lessons done.' },
  { href: '/glossary/', label: 'Terms, in plain words', n: allPlainTerms.length, unit: 'explained', d: 'Every AI and agentic term with an everyday analogy, plus the full A–Z of ' + glossary.length + ' course definitions.' },
  { href: '/cheatsheets/', label: 'Cheat sheets', n: 4, unit: 'entry points', d: 'Which path to run, how much checking a change gets, the prompts worth keeping, and the commands you reach for.' },
  { href: '/tools/', label: 'Tool index', n: tools.length, unit: 'tools', d: 'Every tool named in the course and — more useful — the point at which it earns a place in your setup.' },
  { href: '/sources/', label: 'Sources', n: 0, unit: '', d: 'Who each idea belongs to, and how strong the evidence behind each number really is.' },
];

const writtenTiers = [...new Set(items.map((i) => i.tier))].sort();
const tiersInProgress = ([1, 2, 3, 4] as Tier[]).filter((t) => !writtenTiers.includes(t));
---
<Base title="Agent Shipyard">
  <main id="main" class="home">
    <section class="hero">
      <div class="hero-text">
        <p class="eyebrow">A hands-on course in agentic software development</p>
        <h1>Agents write the code.<br /><span>You make the calls.</span></h1>
        <p class="lede">Go from zero to running a crew of AI agents on real products, and to designing the architecture behind them. One agent you understand completely, then a crew on one product, then a fleet of products, learned by building six apps end to end.</p>
        <div class="cta">
          <a class="key key--primary" href={firstHref}>Start the course <span class="key-hint">→</span></a>
          <a class="key" href={firstHref} data-continue>
            <span>Continue: <b data-continue-title>How this course works</b></span>
          </a>
        </div>
        <ul class="stats">
          {stats.map((s) => <li><b>{s.n}</b>{s.l}</li>)}
        </ul>
      </div>
      <div class="stairs" aria-label="Four tiers, each a step up">
        {([4, 3, 2, 1] as Tier[]).map((t) => (
          <div class={`stair t${t}`} style={`--i:${t}`}>
            <span class="stair-n">Tier {t}</span>
            <span class="stair-name">{tiers[t].name}</span>
          </div>
        ))}
      </div>
    </section>

    <section class="band" data-reveal>
      <div class="wrap">
        <p class="eyebrow">What you'll master</p>
        <h2>Three pillars, one path</h2>
        <div class="pillars stagger">
          <article class="pillar">
            <span class="picon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12a9 9 0 1 1-3-6.7L21 8"/><path d="M21 3v5h-5"/></svg></span>
            <h3>The Loop</h3>
            <p>One repeatable path for every feature: scope it, decide it, build it, prove it, review it, record it. Every decision lives in a file, so work survives any session. From JS Mastery's skills and obra's Superpowers.</p>
          </article>
          <article class="pillar">
            <span class="picon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="5" r="2.5"/><circle cx="5" cy="18" r="2.5"/><circle cx="19" cy="18" r="2.5"/><path d="M12 7.5v4M12 11.5 6.5 16M12 11.5l5.5 4.5"/></svg></span>
            <h3>The Crew</h3>
            <p>Several agents at once, each in its own workspace, behind gates that catch their mistakes, with you as the manager instead of the typist. From Kun Chen's agentic engineering.</p>
          </article>
          <article class="pillar">
            <span class="picon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="8.5" y="14" width="7" height="7" rx="1.5"/><path d="M6.5 10v2h11v-2M12 12v2"/></svg></span>
            <h3>Architecture</h3>
            <p>Designing the system itself: components, data, trust boundaries, scale and failure, and choosing the right workflow and stack for each use case. Trained with decision drills and a mastery exam.</p>
          </article>
        </div>
      </div>
    </section>

    <section class="wrap route">
      <p class="eyebrow">The route</p>
      <h2>Four tiers, each a step higher</h2>
      <p class="sub">
        Nothing appears before you have the foundation for it. Architecture lessons arrive just before the project that
        needs them, and each tier ends with something you can do that you could not do at the start. The gate under each
        tier is the honest test — reach it and the next tier is worth your time, miss it and repeating a project beats
        moving on.
      </p>

      <ul class="legend">
        <li><span class="dot k-start"></span>Setup</li>
        <li><span class="dot k-part"></span>Workflow</li>
        <li><span class="dot k-arch"></span>Architecture</li>
        <li><span class="dot k-project"></span>Build</li>
        <li><span class="dot k-decisions"></span>Judgment</li>
        <li><span class="dot k-exam"></span>Exam</li>
      </ul>

      <ol class="tiers">
        {tierList.map((tl) => (
          <li class={`tier-row t${tl.t}`} data-reveal>
            <div class="tier-head">
              <div class="tier-top">
                <span class="tier-badge">Tier {tl.t}</span>
                <span class="tier-pace">{tl.pace}</span>
              </div>
              <h3>{tl.name}</h3>
              <p class="tier-can"><span class="lead-in">You leave able to</span> {tl.can}</p>
              <p class="tier-why">{tl.why}</p>

              {tl.lessons > 0 ? (
                <div class="tier-meter" data-tier={tl.t} data-slugs={tl.slugs.join(' ')}>
                  <div class="meter-row">
                    <span class="meter-label">Your progress</span>
                    <span class="meter-num"><b data-tier-done>0</b> / {tl.lessons}</span>
                  </div>
                  <div class="meter"><span data-tier-bar style="width:0%"></span></div>
                </div>
              ) : (
                <p class="tier-writing">
                  <span class="lead-in">Not yet written</span>
                  The plan below is firm — the {tl.secs.length} sections and their order are decided. The pages are being
                  written now, and nothing here is playable until they are.
                </p>
              )}

              {tl.builds.length > 0 && (
                <p class="tier-build">
                  <span class="lead-in">You build</span>
                  {tl.builds.map((b, i) => (<><>{i > 0 ? ', ' : ' '}</><b>{b.name}</b></>))}
                </p>
              )}

              <p class="tier-gate"><span class="lead-in">Move on when</span> {tl.gate}</p>
            </div>

            <div class="tier-sections stagger">
              {tl.secs.map((sc) => {
                const Tag = sc.ready ? 'a' : 'div';
                return (
                  <Tag
                    class:list={['sec-card', `k-${sc.kind}`, !sc.ready && 'is-planned']}
                    href={sc.ready ? sc.href : undefined}
                  >
                    {sc.ready ? <ProgressRing scope={sc.id} size={40} /> : <span class="sec-dot" aria-hidden="true" />}
                    <span class="sec-text">
                      <span class="sec-label">
                        {sc.label !== sc.title && <span>{sc.label}</span>}
                        <span class="sec-kind">{sc.kindLabel}</span>
                      </span>
                      <span class="sec-title">{sc.title}</span>
                      <span class="sec-blurb">{sc.blurb}</span>
                      <span class="sec-foot">
                        {sc.ready
                          ? <span class="sec-count">{sc.pages} {sc.pages === 1 ? 'page' : 'pages'}</span>
                          : <span class="sec-soon">being written</span>}
                      </span>
                    </span>
                    {sc.ready && <span class="sec-arrow" aria-hidden="true">→</span>}
                  </Tag>
                );
              })}
            </div>
          </li>
        ))}
      </ol>

      <p class="route-foot">
        The order is the point. Run it out of sequence and you will be choosing between architectures you have not felt
        the consequences of yet.
      </p>
    </section>

    <section class="wrap how" data-reveal>
      <p class="eyebrow">How you learn it</p>
      <h2>Every lesson is built the same way</h2>
      <p class="sub">Reading about agents teaches you nothing. Each lesson gives you the idea in plain words, then makes you run it, then checks that it stuck — and only then counts as done.</p>
      <ol class="anatomy stagger">
        {anatomy.map((a, i) => (
          <li>
            <span class="an-n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{a.k}</h3>
              <p>{a.d}</p>
            </div>
          </li>
        ))}
      </ol>
      <div class="how-note">
        <p><strong>Your progress is yours.</strong> Ticks, notes, quiz answers and drill attempts are saved in this browser — no account, no sign-in, nothing sent anywhere. The ring beside every section fills as you go, and the <b>Continue</b> button always takes you back to where you stopped.</p>
      </div>
    </section>

    <section class="band" id="projects" data-reveal>
      <div class="wrap">
        <p class="eyebrow">Six guided builds</p>
        <h2>Projects that get harder on every front</h2>
        <p class="sub">Each one raises the bar in architecture, security, UI and UX, product and animation, and changes how you work with agents. Every project is walked through milestone by milestone.</p>
        <div class="projects stagger">
          {projects.map((p) => {
            const g = groups.find((x) => x.section.id === p.id);
            const href = g?.items[0]?.href ?? '#';
            return (
              <a class={`project t${p.tier}`} href={href}>
                <span class="p-code">{p.code} · Tier {p.tier}</span>
                <span class="p-name">{p.name}</span>
                <span class="p-pitch">{p.pitch}</span>
                <span class="p-stack">{p.stack.map((s) => <span>{s}</span>)}</span>
              </a>
            );
          })}
        </div>
      </div>
    </section>


    <section class="wrap prereq" data-reveal>
      <p class="eyebrow">Before you start</p>
      <h2>What this course assumes</h2>
      <p class="sub">Being honest about this up front saves you three lessons of confusion. If you have these four, nothing in Tier 1 will lose you.</p>
      <div class="pre-grid stagger">
        {prereqs.map((r) => (
          <div class="pre-card">
            <h3>{r.t}</h3>
            <p>{r.d}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="band" data-reveal>
      <div class="wrap">
        <p class="eyebrow">Alongside the lessons</p>
        <h2>Six reference pages you will keep coming back to</h2>
        <p class="sub">The course is a path you walk once. These are the pages you reopen months later, when you know what you are doing and just need the file, the wording or the word.</p>
        <div class="refs stagger">
          {refs.map((r) => (
            <a class="ref-card" href={r.href}>
              <span class="ref-top">
                <span class="ref-label">{r.label}</span>
                {r.n > 0 && <span class="ref-n">{r.n} <i>{r.unit}</i></span>}
              </span>
              <span class="ref-d">{r.d}</span>
              <span class="ref-go">Open →</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="wrap closing" data-reveal>
      <h2>You own a workflow kit by the end</h2>
      <p class="sub">Instruction files, skills, subagents, hooks and gates, built one lesson at a time, then packaged as a Claude Code plugin you can install into any new project.</p>
      <div class="cta">
        <a class="key key--primary" href={firstHref}>Start with lesson one</a>
        <a class="key key--brass" href="/kit/">See the kit</a>
      </div>
      {tiersInProgress.length > 0 && (
        <p class="status">
          <b>Where the course stands today.</b> Tier{tiersInProgress.length > 1 ? 's' : ''} {tiersInProgress.join(' and ')} {tiersInProgress.length > 1 ? 'are' : 'is'} still being written.
          Everything listed above exists as a plan; {items.length} pages are written and playable end to end, and the reference pages
          say plainly when a term or tool belongs to a lesson that is not there yet. Nothing here pretends to be finished that is not.
        </p>
      )}
    </section>
  </main>
</Base>

<style>
  .home { overflow-x: clip; }
  .wrap { max-width: 1180px; margin: 0 auto; padding: 80px 22px; }
  .eyebrow { font: 700 0.76rem var(--font-mono); letter-spacing: 0.13em; text-transform: uppercase; color: var(--accent-strong); margin-bottom: 12px; }
  h2 { font-size: clamp(1.9rem, 4.2vw, 2.8rem); font-weight: 750; letter-spacing: -0.03em; margin-bottom: 14px; }
  .sub { color: var(--ink-soft); font-size: 1.1rem; max-width: 62ch; margin-bottom: 34px; }

  .hero { max-width: 1180px; margin: 0 auto; padding: 72px 22px 64px; display: grid; gap: 48px; align-items: center; }
  @media (min-width: 980px) { .hero { grid-template-columns: 1.25fr 0.75fr; padding-top: 96px; } }
  .hero h1 { font-size: clamp(2.6rem, 7vw, 4.9rem); font-weight: 800; line-height: 1.0; letter-spacing: -0.045em; margin-bottom: 22px; }
  .hero h1 span { background: linear-gradient(100deg, var(--accent) 10%, var(--sky) 55%, var(--tier-4) 95%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .lede { font-size: clamp(1.08rem, 2vw, 1.24rem); color: var(--ink-soft); max-width: 58ch; margin-bottom: 30px; }
  .cta { display: flex; flex-wrap: wrap; gap: 16px; margin-bottom: 36px; }
  .cta .key { font-size: 1rem; padding: 0.8em 1.3em 0.88em; }
  .cta .key b { font-weight: 700; }
  .stats { list-style: none; padding: 0; margin: 0; display: flex; flex-wrap: wrap; gap: 10px 28px; color: var(--ink-soft); font-size: 0.95rem; }
  .stats b { font: 750 1.5rem var(--font-display); color: var(--ink); margin-right: 6px; font-variant-numeric: tabular-nums; }

  .stairs { position: relative; height: 380px; display: none; }
  @media (min-width: 980px) { .stairs { display: block; } }
  .stair {
    position: absolute; right: calc((4 - var(--i)) * 13%); bottom: calc((var(--i) - 1) * 84px);
    width: 62%; height: 96px; padding: 16px 20px;
    display: flex; flex-direction: column; justify-content: center;
    color: #fff; border-radius: 18px;
    background: linear-gradient(180deg, color-mix(in srgb, var(--t) 78%, #fff), var(--t) 60%);
    border: 1px solid color-mix(in srgb, var(--t) 70%, #000);
    box-shadow: 0 10px 0 color-mix(in srgb, var(--t) 55%, #000), 0 22px 34px rgba(0, 0, 0, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.35);
    transform: translateY(0); transition: transform 0.12s ease, box-shadow 0.12s ease;
  }
  .stair:hover { transform: translateY(6px); box-shadow: 0 4px 0 color-mix(in srgb, var(--t) 55%, #000), 0 10px 20px rgba(0, 0, 0, 0.16); }
  .stair-n { font: 700 0.74rem var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; opacity: 0.85; }
  .stair-name { font: 750 1.55rem var(--font-display); letter-spacing: -0.02em; }
  .stair { color: var(--on-tier); }
  @media (prefers-reduced-motion: reduce) { .stair { transition: none; } }

  .band { background: var(--bg-band); border-block: 1px solid var(--line); }
  .pillars { display: grid; gap: 20px; }
  @media (min-width: 860px) { .pillars { grid-template-columns: repeat(3, 1fr); } }
  .pillar { padding: 28px 26px 18px; background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-l); box-shadow: var(--shadow-1); }
  .pillar h3 { font-size: 1.4rem; margin: 16px 0 10px; }
  .pillar p { color: var(--ink-soft); }
  .picon { width: 48px; height: 48px; display: grid; place-items: center; border-radius: 13px; color: #fff; background: linear-gradient(180deg, var(--key-primary-top), var(--key-primary-face)); box-shadow: 0 4px 0 var(--key-primary-side); }
  .picon svg { width: 24px; height: 24px; }

  /* Legend */
  .legend { list-style: none; padding: 0; margin: -18px 0 30px; display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .legend li { display: flex; align-items: center; gap: 7px; font: 600 0.78rem var(--font-mono); color: var(--ink-faint); }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--k, var(--ink-faint)); flex: none; }
  .k-start { --k: var(--ink-faint); }
  .k-part { --k: var(--accent); }
  .k-arch { --k: var(--sky); }
  .k-project { --k: var(--brass-strong); }
  .k-decisions { --k: var(--tier-4); }
  .k-exam { --k: var(--coral); }

  /* The spine: a line running down the four tiers */
  .tiers { list-style: none; padding: 0; margin: 0; display: grid; gap: 22px; position: relative; }
  @media (min-width: 900px) {
    .tiers::before {
      content: ''; position: absolute; left: 2px; top: 26px; bottom: 26px; width: 2px;
      background: linear-gradient(180deg, var(--tier-1), var(--tier-2) 33%, var(--tier-3) 66%, var(--tier-4));
      opacity: 0.35; border-radius: 2px;
    }
  }
  .tier-row {
    position: relative; display: grid; gap: 18px; padding: 26px;
    background: var(--surface); border: 1px solid var(--line); border-left: 5px solid var(--t);
    border-radius: var(--radius-l); transition: box-shadow 0.25s ease, border-color 0.25s ease;
  }
  .tier-row:hover { box-shadow: var(--shadow-1); }
  @media (min-width: 900px) { .tier-row { grid-template-columns: 330px 1fr; align-items: start; } }

  .tier-top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .tier-badge { font: 700 0.72rem var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--t); }
  .tier-pace { font: 600 0.72rem var(--font-mono); color: var(--ink-faint); background: var(--surface-2); border-radius: 99px; padding: 3px 9px; white-space: nowrap; }
  .tier-head h3 { font-size: 1.55rem; margin: 6px 0 8px; letter-spacing: -0.02em; }
  .tier-head p { color: var(--ink-soft); font-size: 0.94rem; margin: 0 0 10px; }
  .lead-in { font: 700 0.64rem var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-faint); display: block; margin-bottom: 2px; }
  .tier-can { color: var(--ink) !important; font-weight: 550; }
  .tier-why { font-size: 0.9rem !important; font-style: italic; }
  .tier-build b { font-weight: 650; color: var(--ink); }
  .tier-gate { padding-top: 10px; border-top: 1px dashed var(--line); margin-bottom: 0 !important; }

  .tier-meter { margin: 14px 0 12px; }
  .meter-row { display: flex; align-items: baseline; justify-content: space-between; gap: 10px; margin-bottom: 5px; }
  .meter-label { font: 700 0.64rem var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--ink-faint); }
  .meter-num { font: 600 0.78rem var(--font-mono); color: var(--ink-soft); font-variant-numeric: tabular-nums; }
  .meter-num b { color: var(--t); }
  .meter { height: 6px; background: var(--surface-3); border-radius: 99px; overflow: hidden; }
  .meter span { display: block; height: 100%; width: 0; background: var(--t); border-radius: 99px; transition: width 0.9s cubic-bezier(0.22, 1, 0.36, 1); }

  .tier-sections { display: grid; gap: 11px; grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); }
  .sec-card {
    position: relative; display: flex; align-items: flex-start; gap: 12px; padding: 13px 14px;
    text-decoration: none; color: var(--ink); background: var(--surface-2);
    border: 1px solid var(--line); border-radius: 13px; overflow: hidden;
    transition: border-color 0.2s ease, transform 0.2s ease, background 0.2s ease;
  }
  .sec-card::before { content: ''; position: absolute; inset: 0 auto 0 0; width: 3px; background: var(--k, transparent); opacity: 0.85; }
  .sec-card:hover { border-color: var(--t); color: var(--ink); transform: translateY(-3px); background: var(--surface); }
  .sec-card:hover .sec-arrow { opacity: 1; transform: translateX(0); }
  .sec-text { display: flex; flex-direction: column; line-height: 1.3; min-width: 0; flex: 1; }
  .sec-label { display: flex; align-items: center; gap: 8px; font: 650 0.66rem var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-faint); }
  .sec-kind { color: var(--k, var(--ink-faint)); }
  .sec-title { font-weight: 650; font-size: 0.95rem; margin-top: 2px; }
  .sec-blurb { font-size: 0.83rem; color: var(--ink-soft); margin-top: 5px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .sec-foot { display: flex; flex-wrap: wrap; gap: 6px 10px; margin-top: 8px; font: 600 0.68rem var(--font-mono); color: var(--ink-faint); }
  .sec-soon { color: var(--brass-strong); }
  .sec-arrow { align-self: center; color: var(--t); font-size: 1.05rem; opacity: 0; transform: translateX(-4px); transition: opacity 0.2s ease, transform 0.2s ease; }

  .route-foot { margin-top: 26px; color: var(--ink-soft); max-width: 66ch; font-size: 0.96rem; }

  .projects { display: grid; gap: 20px; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  .project {
    display: flex; flex-direction: column; gap: 8px; padding: 24px 22px 20px; text-decoration: none; color: var(--ink);
    background: var(--surface); border: 1px solid var(--line); border-top: 5px solid var(--t); border-radius: var(--radius-l);
    box-shadow: 0 6px 0 color-mix(in srgb, var(--t) 30%, var(--line)), var(--shadow-1);
    transition: transform 0.1s ease, box-shadow 0.1s ease;
  }
  .project:hover { color: var(--ink); transform: translateY(4px); box-shadow: 0 2px 0 color-mix(in srgb, var(--t) 30%, var(--line)), var(--shadow-1); }
  .p-code { font: 700 0.72rem var(--font-mono); letter-spacing: 0.1em; text-transform: uppercase; color: var(--t); }
  .p-name { font: 750 1.6rem var(--font-display); letter-spacing: -0.02em; }
  .p-pitch { color: var(--ink-soft); font-size: 0.98rem; flex: 1; }
  .p-stack { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
  .p-stack span { font: 600 0.72rem var(--font-mono); padding: 3px 9px; border-radius: 99px; background: var(--surface-2); border: 1px solid var(--line); color: var(--ink-soft); }

  .closing { text-align: center; }
  .closing .sub { margin-inline: auto; }
  .closing .cta { justify-content: center; }

  /* --- How a lesson works --- */
  .anatomy { list-style: none; padding: 0; margin: 0; display: grid; gap: 20px 34px; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); counter-reset: none; }
  .anatomy li { display: grid; grid-template-columns: auto 1fr; gap: 14px; align-items: start; }
  .an-n { font: 750 0.9rem var(--font-mono); color: var(--accent-strong); background: var(--surface-2); border-radius: 9px; padding: 5px 9px; font-variant-numeric: tabular-nums; }
  .anatomy h3 { font: 750 1.08rem var(--font-display); letter-spacing: -0.015em; margin-bottom: 4px; }
  .anatomy p { color: var(--ink-soft); font-size: 0.96rem; margin: 0; }
  .how-note { margin-top: 34px; background: var(--surface); border: 1px solid var(--line); border-left: 4px solid var(--accent); border-radius: var(--radius-l); padding: 18px 22px; }
  .how-note p { margin: 0; color: var(--ink-soft); max-width: 78ch; }
  .how-note b { color: var(--ink); }

  /* --- Prerequisites --- */
  .pre-grid { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); }
  .pre-card { background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-l); padding: 18px 20px; }
  .pre-card h3 { font: 750 1.05rem var(--font-display); letter-spacing: -0.015em; margin-bottom: 6px; }
  .pre-card p { color: var(--ink-soft); font-size: 0.94rem; margin: 0; }

  /* --- Reference cards --- */
  .refs { display: grid; gap: 16px; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); }
  .ref-card {
    display: flex; flex-direction: column; gap: 10px; text-decoration: none; color: inherit;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-l);
    padding: 20px 22px; transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .ref-card:hover { transform: translateY(-2px); border-color: var(--accent); box-shadow: var(--shadow-2, var(--shadow-1)); }
  .ref-top { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .ref-label { font: 750 1.15rem var(--font-display); letter-spacing: -0.02em; }
  .ref-n { font: 700 0.78rem var(--font-mono); color: var(--accent-strong); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .ref-n i { font-style: normal; color: var(--ink-faint); font-weight: 600; }
  .ref-d { color: var(--ink-soft); font-size: 0.95rem; flex: 1; }
  .ref-go { font: 700 0.8rem var(--font-mono); color: var(--accent-strong); }

  /* --- Honest status --- */
  .status { margin: 28px auto 0; max-width: 74ch; color: var(--ink-soft); font-size: 0.95rem; background: var(--surface-2); border: 1px dashed var(--line); border-radius: var(--radius-l); padding: 16px 20px; }
  .status b { color: var(--ink); }


  /* Planned sections: shown, but plainly not clickable. */
  .sec-card.is-planned { background: transparent; border-style: dashed; cursor: default; }
  .sec-card.is-planned .sec-title { color: var(--ink-soft); }
  .sec-card.is-planned:hover { transform: none; border-color: var(--line); background: transparent; }
  .sec-dot { width: 40px; height: 40px; flex: none; border-radius: 50%; border: 2px dashed var(--line-strong); }
  .tier-writing { font-size: 0.9rem !important; padding-top: 12px; border-top: 1px dashed var(--line); }

  /* ---------------------------------------------------------------
     Motion. Everything here is opt-in: the initial hidden state only
     applies when JS is running (html.has-js) and the reader has not
     asked for less motion, so the page is complete without either.
     Only transform and opacity animate, so nothing reflows.
  ---------------------------------------------------------------- */
  @media (prefers-reduced-motion: no-preference) {
    :global(html.has-js) [data-reveal] { opacity: 0; transform: translateY(22px); }
    :global(html.has-js) [data-reveal].is-in {
      opacity: 1; transform: none;
      transition: opacity 0.6s cubic-bezier(0.22, 1, 0.36, 1), transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
    }
    /* Children of a .stagger grid arrive one after another behind their parent. */
    :global(html.has-js) [data-reveal] .stagger > * { opacity: 0; transform: translateY(12px); }
    :global(html.has-js) [data-reveal].is-in .stagger > * {
      opacity: 1; transform: none;
      transition: opacity 0.5s ease var(--d, 0ms), transform 0.5s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0ms),
                  border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
    }
    /* Shown without animating: already scrolled past, so there is nothing to reveal. */
    :global(html.has-js) [data-reveal].no-anim,
    :global(html.has-js) [data-reveal].no-anim .stagger > * { transition: none; }

    .stagger > :nth-child(1) { --d: 60ms; }
    .stagger > :nth-child(2) { --d: 115ms; }
    .stagger > :nth-child(3) { --d: 170ms; }
    .stagger > :nth-child(4) { --d: 225ms; }
    .stagger > :nth-child(5) { --d: 280ms; }
    .stagger > :nth-child(6) { --d: 335ms; }
    .stagger > :nth-child(7) { --d: 390ms; }
    .stagger > :nth-child(n + 8) { --d: 445ms; }

    /* Hero entrance. */
    :global(html.has-js) .hero-text > * { animation: rise 0.7s cubic-bezier(0.22, 1, 0.36, 1) both; }
    :global(html.has-js) .hero-text > :nth-child(1) { animation-delay: 0.04s; }
    :global(html.has-js) .hero-text > :nth-child(2) { animation-delay: 0.12s; }
    :global(html.has-js) .hero-text > :nth-child(3) { animation-delay: 0.20s; }
    :global(html.has-js) .hero-text > :nth-child(4) { animation-delay: 0.28s; }
    :global(html.has-js) .hero-text > :nth-child(5) { animation-delay: 0.36s; }
    :global(html.has-js) .stair { animation: stack 0.8s cubic-bezier(0.22, 1, 0.36, 1) both; animation-delay: calc(0.18s + (4 - var(--i)) * 0.09s); }

    /* The headline gradient drifts slowly, so the page is never quite static. */
    :global(html.has-js) .hero h1 span { background-size: 220% 100%; animation: drift 14s ease-in-out infinite; }
  }

  @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @keyframes stack { from { opacity: 0; transform: translateY(-26px) scale(0.97); } to { opacity: 1; transform: none; } }
  @keyframes drift { 0%, 100% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } }

  /* The scroll-tied shift the script sets, layered on top of the hover lift. */
  .stair { translate: 0 var(--shift, 0px); }
  .stair:hover { translate: 0 var(--shift, 0px); }
</style>

<script is:inline>
  (function () {
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ---- Tier meters: how far through each tier you are ---- */
    var done = {};
    try {
      var raw = localStorage.getItem('shipyard:v1');
      if (raw) done = (JSON.parse(raw) || {}).done || {};
    } catch (e) {}

    var meters = [].slice.call(document.querySelectorAll('.tier-meter'));
    meters.forEach(function (m) {
      var slugs = (m.getAttribute('data-slugs') || '').split(' ').filter(Boolean);
      var hit = slugs.filter(function (s) { return !!done[s]; }).length;
      m.dataset.hit = String(hit);
      m.dataset.total = String(slugs.length);
      var num = m.querySelector('[data-tier-done]');
      if (num && reduced) num.textContent = String(hit);
      var bar = m.querySelector('[data-tier-bar]');
      if (bar && reduced) bar.style.width = (slugs.length ? Math.round((hit / slugs.length) * 100) : 0) + '%';
    });

    /* Count a number up, but only once it is on screen. */
    function countUp(el, to, ms) {
      if (reduced || to === 0) { el.textContent = String(to); return; }
      var start = performance.now();
      (function step(now) {
        var p = Math.min(1, (now - start) / ms);
        var eased = 1 - Math.pow(1 - p, 3);
        el.textContent = String(Math.round(to * eased));
        if (p < 1) requestAnimationFrame(step);
      })(start);
    }

    /* Fill in a tier's bar and counter once its row is on screen. */
    function runMeter(row, animate) {
      var meter = row.querySelector ? row.querySelector('.tier-meter') : null;
      if (!meter) return;
      var hit = +meter.dataset.hit || 0;
      var total = +meter.dataset.total || 0;
      var bar = meter.querySelector('[data-tier-bar]');
      var num = meter.querySelector('[data-tier-done]');
      var pct = total ? Math.round((hit / total) * 100) + '%' : '0%';
      if (!animate) {
        if (bar) { bar.style.transition = 'none'; bar.style.width = pct; }
        if (num) num.textContent = String(hit);
        return;
      }
      setTimeout(function () {
        if (bar) bar.style.width = pct;
        if (num) countUp(num, hit, 700);
      }, 180);
    }

    var targets = [].slice.call(document.querySelectorAll('[data-reveal]'));

    function showAll() {
      targets.forEach(function (el) {
        el.classList.add('is-in', 'no-anim');
        runMeter(el, false);
      });
    }

    /* ---- Reveal on scroll ---- */
    if (!reduced && 'IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
          runMeter(e.target, true);
        });
      }, { rootMargin: '0px 0px -12% 0px', threshold: 0.12 });

      // Anything the reader has already scrolled past is shown at once, with no
      // transition. Without this, a restored scroll position (the back button,
      // a reload part-way down, a link to an anchor) leaves every section above
      // the viewport stuck at opacity 0, because they never intersect again.
      function prime() {
        targets.forEach(function (el) {
          if (el.classList.contains('is-in')) return;
          if (el.getBoundingClientRect().bottom < 0) {
            el.classList.add('is-in', 'no-anim');
            io.unobserve(el);
            runMeter(el, false);
          } else {
            io.observe(el);
          }
        });
      }

      prime();
      // Scroll restoration can land after this script runs, so check again once
      // the page has fully loaded and whenever it comes back from the bfcache.
      window.addEventListener('load', prime);
      window.addEventListener('pageshow', function (e) { if (e.persisted) prime(); });

      /* Hero stats count up on load. */
      [].slice.call(document.querySelectorAll('.stats b')).forEach(function (b, i) {
        var to = parseInt(b.textContent, 10);
        if (isNaN(to)) return;
        b.textContent = '0';
        setTimeout(function () { countUp(b, to, 900); }, 420 + i * 90);
      });
    } else {
      showAll();
    }

    /* ---- Stairs: a gentle parallax tied to scroll ---- */
    var stairs = [].slice.call(document.querySelectorAll('.stair'));
    if (!reduced && stairs.length) {
      var ticking = false;
      window.addEventListener('scroll', function () {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(function () {
          var y = window.scrollY;
          if (y < 700) {
            stairs.forEach(function (st, i) {
              st.style.setProperty('--shift', (y * (0.018 + i * 0.012)).toFixed(2) + 'px');
            });
          }
          ticking = false;
        });
      }, { passive: true });
    }
  })();
</script>
