---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/figtree';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import { navItems } from '../lib/nav';

interface Props { title: string; description?: string; withDrawer?: boolean; active?: string }
const { title, description = 'A hands-on course in agentic software development: one agent, a crew, a fleet, and the architecture decisions behind them.', withDrawer = false, active } = Astro.props;
const items = await navItems();
const courseData = items.map((i) => ({ s: i.slug, h: i.href, t: i.title, sec: i.section, k: i.kind, c: i.competencies }));
const fullTitle = title === 'Agent Shipyard' ? title : `${title} · Agent Shipyard`;
const links = [
  { href: '/learn/start/how-it-works/', label: 'Start', key: 'start' },
  { href: '/#projects', label: 'Projects', key: 'projects' },
  { href: '/kit/', label: 'Your kit', key: 'kit' },
  { href: '/skills/', label: 'Skills map', key: 'skills' },
  { href: '/glossary/', label: 'Glossary', key: 'glossary' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#0b1320" id="theme-color" />
    <script is:inline>
      // Runs before paint: no flash of the wrong theme, and no hidden content
      // for readers without JS (the motion styles are gated on .has-js).
      (function () {
        var d = document.documentElement;
        d.classList.add('has-js');
        // Dark is the default. 'system' and 'light' are things you choose.
        var t = 'dark';
        try { t = localStorage.getItem('shipyard-theme') || 'dark'; } catch (e) {}
        if (t === 'light' || t === 'dark') d.setAttribute('data-theme', t);
        var m = document.getElementById('theme-color');
        var isDark = t === 'dark' || (t === 'system' && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (m) m.setAttribute('content', isDark ? '#0b1320' : '#f6f1e7');
      })();
    </script>
  </head>
  <body>
    <a class="visually-hidden" href="#main">Skip to content</a>
    <header class="topbar">
      {withDrawer && (
        <button class="icon-btn drawer-btn" type="button" id="drawer-btn" aria-controls="sidebar" aria-expanded="false" aria-label="Open course map">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg>
        </button>
      )}
      <a class="brand" href="/" aria-label="Agent Shipyard home">
        <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
          <rect x="1.5" y="1.5" width="29" height="29" rx="8" style="fill:var(--key-primary-face);stroke:var(--key-primary-side);stroke-width:1.5" />
          <rect x="1.5" y="1.5" width="29" height="25" rx="8" style="fill:var(--key-primary-top)" />
          <g style="fill:none;stroke:#fff;stroke-width:2.1;stroke-linecap:round;stroke-linejoin:round">
            <circle cx="16" cy="8.6" r="2" />
            <path d="M16 10.6v11M11.5 14h9M9.5 17.5c.6 3 3.3 5 6.5 5s5.9-2 6.5-5" />
          </g>
        </svg>
        <span class="brand-name">Agent <span>Shipyard</span></span>
      </a>
      <nav class="topnav" aria-label="Site">
        {links.map((l) => <a href={l.href} aria-current={active === l.key ? 'page' : undefined}>{l.label}</a>)}
      </nav>
      <button class="icon-btn search-btn" type="button" id="search-btn" aria-label="Search the course">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span class="label">Search</span><kbd>/</kbd>
      </button>
      <button class="icon-btn" type="button" id="theme-btn" aria-label="Theme: dark">
        <svg data-icon="system" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
        <svg data-icon="light" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" hidden><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        <svg data-icon="dark" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" hidden><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
      </button>
    </header>

    <slot />

    <footer class="site-foot">
      <div class="inner">
        <span>Agent Shipyard · a course in agentic software development · content checked September 2026</span>
        <span><a href="/sources/">Sources</a> · <a href="/tools/">Tool index</a> · <a href="/cheatsheets/">Cheat sheets</a></span>
      </div>
    </footer>

    <div class="search-modal" id="search-modal" hidden>
      <div class="search-panel" role="dialog" aria-modal="true" aria-label="Search the course">
        <div id="search-ui"></div>
        <p class="note" id="search-note">Search works on the built site (<code>npm run build</code> then <code>npm run preview</code>). Press <kbd>Esc</kbd> to close.</p>
      </div>
    </div>

    <script type="application/json" id="course-data" set:html={JSON.stringify(courseData)} />
    <script>
      import '../scripts/app.ts';
    </script>
  </body>
</html>
